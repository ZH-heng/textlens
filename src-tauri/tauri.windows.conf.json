{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TextLens",
  "version": "0.4.1",
  "identifier": "com.local.textlens",
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "TextLens 设置",
        "url": "settings/index.html",
        "width": 760,
        "height": 780,
        "minWidth": 660,
        "minHeight": 600,
        "visible": false,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "skipTaskbar": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "../apps/windows/icons/icon.ico"
    ],
    "shortDescription": "轻量 Windows 划词助手",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "../apps/windows/icons/icon.ico",
        "uninstallerIcon": "../apps/windows/icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "TextLens"
      }
    },
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSE.selection-hook": "LICENSE.selection-hook"
    }
  }
}
