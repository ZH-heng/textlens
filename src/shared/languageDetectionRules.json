    {
      "pattern": "\\b(?:[A-Za-z][A-Za-z0-9]*_[A-Za-z0-9_]+|[a-z]+(?:[A-Z][A-Za-z0-9]*)+)\\b",
      "replacement": " ",
      "caseSensitive": true
